# Imagen del frontal. Dos usos:
#  - producción (último stage): compila apps/web con Vite y la documentación (apps/docs, VitePress)
#    y lo sirve todo con nginx (la doc en /docs), que además reenvía /api a la API (mismo origen,
#    sin CORS). docker build -f Dockerfile.web .
#  - local (target dev): servidor de desarrollo de Vite con recarga en caliente; el código se monta
#    como volumen (ver docker-compose.local.yml).
FROM node:22-alpine AS deps
WORKDIR /app

# 1. Manifiestos de todos los workspaces (npm ci exige que cuadren con el lockfile)
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/bot/package.json apps/bot/
COPY apps/docs/package.json apps/docs/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/clinical/package.json packages/clinical/
COPY packages/coach/package.json packages/coach/
COPY packages/connections/package.json packages/connections/
COPY packages/db/package.json packages/db/
COPY packages/engine/package.json packages/engine/
COPY packages/llm-usage/package.json packages/llm-usage/
COPY packages/logger/package.json packages/logger/
COPY packages/mcp/package.json packages/mcp/
COPY packages/nutrition/package.json packages/nutrition/
COPY packages/push/package.json packages/push/
COPY packages/email/package.json packages/email/
COPY packages/queue/package.json packages/queue/
COPY packages/timeline/package.json packages/timeline/
COPY packages/google-health/package.json packages/google-health/
COPY packages/intervals-icu/package.json packages/intervals-icu/
COPY packages/motra/package.json packages/motra/
COPY packages/xiaomi/package.json packages/xiaomi/

# 2. Dependencias del frontal y de la documentación (vite y vitepress van en devDependencies:
#    hacen falta para compilar)
RUN npm ci --workspace=@digitaltwin/web --workspace=@digitaltwin/docs \
      --include-workspace-root=false && npm cache clean --force

# Desarrollo: el código llega por volumen
FROM deps AS dev
WORKDIR /app/apps/web
CMD ["npx", "vite", "--host", "0.0.0.0"]

# Desarrollo de la documentación (VitePress con recarga en caliente; Vite le reenvía /docs)
FROM deps AS docs-dev
WORKDIR /app/apps/docs
CMD ["npx", "vitepress", "dev", "--host", "0.0.0.0", "--port", "5174"]

FROM deps AS build
# 3. Código y build
COPY apps/web ./apps/web
RUN npm run build -w @digitaltwin/web
COPY apps/docs ./apps/docs
RUN npm run build -w @digitaltwin/docs

FROM nginx:1.29-alpine
COPY docker/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY --from=build /app/apps/docs/.vitepress/dist /usr/share/nginx/html/docs
