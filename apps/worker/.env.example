# Worker en local (make worker). En Docker usa los secretos de Infisical de /api.
LOG_LEVEL=info
# La BD de make docker-up (puerto 5433)
DATABASE_URL=postgres://digitaltwin:CAMBIA@localhost:5433/digitaltwin
# La misma que la API (descifra las credenciales de las conexiones)
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIMEZONE=Europe/Madrid
