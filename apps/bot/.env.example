NODE_ENV=development
LOG_LEVEL=debug
# Token del bot (@BotFather)
TELEGRAM_BOT_TOKEN=
# Tu ID numérico de Telegram (varios separados por coma). Déjalo vacío la primera vez:
# arranca el bot, escríbele y te contesta con tu ID. Ponlo aquí y reinicia.
TELEGRAM_ALLOWED_USER_IDS=
TIMEZONE=Europe/Madrid
# API de Digital Twin (hace la parte de IA) y la clave del bot: la de "bot:<clave>" en
# DIGITALTWIN_API_KEYS de apps/api/.env (aquí solo <clave>)
API_URL=http://localhost:3000
DIGITALTWIN_API_KEY=
# La misma que DIGITALTWIN_WEBHOOK_SECRET de la API: firma las comidas que se guardan
DIGITALTWIN_WEBHOOK_SECRET=
