NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Orígenes permitidos separados por coma (frontal). "*" permite todos.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Rate limit: peticiones por ventana (ms)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Tamaño máximo del body JSON
BODY_LIMIT=1mb
# Número de proxies delante (nginx, load balancer...). 0 si ninguno.
TRUST_PROXY=0
# Webhooks de Google Health: valor completo de la cabecera Authorization (mín. 16 caracteres).
# Comentado = endpoint /webhooks/google-health desactivado.
# GOOGLE_HEALTH_WEBHOOK_SECRET=Bearer cambia-esto-por-un-secreto-largo
# API keys de nuestros clientes como "nombre:clave" separadas por coma (clave de 16+ caracteres).
# Protegen todo /api/v1 menos /api/v1/health. Vacío = solo /api/v1/health.
# Genera una con: openssl rand -hex 32
DIGITALTWIN_API_KEYS=bot:cambia-esto-por-una-clave-larga
# Tamaño máximo del body en /api/v1/nutrition (fotos en base64)
NUTRITION_BODY_LIMIT=10mb
# LLM para estimar macros (compatible con la API de OpenAI). Por defecto DeepSeek deepseek-flash.
# Sin LLM_API_KEY, /api/v1/nutrition/analyze y /refine responden 503.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM del coach (/api/v1/coach); por defecto el de arriba. Necesita también BD.
# COACH_LLM_API_KEY=
# COACH_LLM_BASE_URL=https://api.deepseek.com
# COACH_LLM_MODEL=deepseek-flash
# COACH_MAX_STEPS=8
# Precios en USD por millón de tokens (modelo:entrada/caché/salida), para estimar el gasto
# LLM_PRICES=deepseek-flash:0.28/0.028/0.42
# LLM_BALANCE_WARN_USD=2
# Gasto de IA al día por usuario (USD) con la clave de la app; en Usuarios se cambia por persona
# AI_DAILY_LIMIT_USD=0.25
TIMEZONE=Europe/Madrid
# PostgreSQL + TimescaleDB (digitaltwin-db de make docker-up, publicada en localhost:5433).
# La clave es DIGITALTWIN_DB_PASSWORD de .env.infisical. Comentada = API sin BD.
# DATABASE_URL=postgres://digitaltwin:<clave>@localhost:5433/digitaltwin

# Firma (HMAC) de los eventos del bot a /webhooks/digitaltwin. La misma en apps/bot/.env.
# Genérala con: openssl rand -hex 32. Sin ella ese webhook no se monta.
DIGITALTWIN_WEBHOOK_SECRET=
