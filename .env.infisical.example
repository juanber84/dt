# Acceso a Infisical para `make docker-up` (cópialo a .env.infisical; está en .gitignore).
# URL de tu Infisical (la de la barra del navegador), p. ej. https://app.infisical.com
INFISICAL_DOMAIN=
INFISICAL_PROJECT_ID=
# Entorno de Infisical (slug): dev, staging o prod
INFISICAL_ENV=dev
# Autenticación: o un token...
INFISICAL_TOKEN=
# ...o una machine identity (universal auth)
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# Contraseña de la BD (digitaltwin-db). No va en Infisical porque la imagen de Postgres no lo usa.
# Genérala con: openssl rand -hex 24
DIGITALTWIN_DB_PASSWORD=
